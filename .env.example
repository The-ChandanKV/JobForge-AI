# SQLite is the native default. Compose injects its PostgreSQL URL.
# DATABASE_URL=sqlite:///data/jobforge.sqlite3
# JOBFORGE_DATA=data
# Optional local login token. Generate a long random token and keep it private.
JOBFORGE_ACCESS_TOKEN=
LLM_PROVIDER=ollama
AUTOMATION_MODE=AUTONOMOUS_PREPARATION
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen2.5:1.5b
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=
OPENAI_API_KEY=
OPENAI_MODEL=
OPENAI_BASE_URL=https://api.openai.com/v1
# Optional SMTP-over-TLS notification digest, only to a configured recipient.
# JOBFORGE_EMAIL_ENABLED=false
# JOBFORGE_SMTP_HOST=
# JOBFORGE_SMTP_PORT=465
# JOBFORGE_SMTP_USER=
# JOBFORGE_SMTP_PASSWORD=
# JOBFORGE_SMTP_FROM=
# JOBFORGE_NOTIFICATION_EMAIL=
# Only for an employer's explicitly authorized Greenhouse test/live board.
# JOBFORGE_GREENHOUSE_AUTHORIZED=false
# JOBFORGE_GREENHOUSE_VERIFICATION_REFERENCE=
# JOBFORGE_GREENHOUSE_BOARD=
# JOBFORGE_GREENHOUSE_KEY=
# TECTONIC_BIN=tectonic
# JOBFORGE_NODE_BIN=node
# TECTONIC_BUNDLE=/path/to/local/tectonic-bundle.tar
# JOBFORGE_BROWSER_EXECUTABLE=C:/Program Files/Google/Chrome/Application/chrome.exe
JOBFORGE_MOCK_ORIGIN=http://127.0.0.1:8000
# Optional Compose overrides
# COMPOSE_OLLAMA_BASE_URL=http://ollama:11434
# POSTGRES_PASSWORD=change-me-for-shared-environments
